    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.18, 0.18, 0.18)]
        custom string romoB:role = "static_ground"
        double size = 1
        float3 xformOp:scale = (10, 10, 0.02)
