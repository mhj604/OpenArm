# Active DP3 rollout bindings for the trained OpenArm-v1 bimanual policy.
DP3_CHECKPOINT=/home/mh/openarm_dp3/outputs/2026.07.17/13.09.09_train_simple_dp3_openarm/checkpoints/latest.ckpt
DP3_DATASET=/home/mh/openarm_dp3/data/processed/openarm_cube_to_point.zarr
DP3_PROFILE=/home/mh/openarm_dp3/configs/dp3_rollout_profile.json
DP3_ZERO_POSE_CONFIG=/home/mh/openarm_dp3/configs/openarm_zero_pose.json

DP3_HARDWARE_CONFIG=/home/mh/openarm_dp3/configs/hardware.yaml
DP3_COLLECTION_CONFIG=/home/mh/openarm_dp3/configs/collection.yaml
DP3_WORKSPACE_CONFIG=/home/mh/openarm_dp3/configs/workspace_crop.yaml

OPENARM_LEFT_CAN=can1
OPENARM_RIGHT_CAN=can0

DP3_CONTROL_HOST=127.0.0.1
DP3_ACTION_PORT=29520
DP3_STATE_PORT=29521
DP3_FPS=15
# Per-cycle task timeout. Continuous mode stays alive after a successful cycle,
# returns to zero, and waits for the next cube. Set 0 only to remove the per-task timeout.
DP3_DURATION_S=${DP3_DURATION_S:-30}
DP3_CONTINUOUS=${DP3_CONTINUOUS:-1}

DP3_COMMAND_STALE_TIMEOUT_S=${DP3_COMMAND_STALE_TIMEOUT_S:-0.75}
# Final operator-tuned profile: two 50% reductions followed by three 25%
# increases from the original 0.12rad aggressive profile.
DP3_MAX_ARM_DELTA_RAD=${DP3_MAX_ARM_DELTA_RAD:-0.05859375}
DP3_MAX_GRIPPER_DELTA_RAD=${DP3_MAX_GRIPPER_DELTA_RAD:-0.08}

# The arm zero target is the same seven-zero-radian target used by the existing
# ExoArm bridge. Grippers are clipped to the learned open-command bound.
DP3_MAXIMUM_INITIAL_ZERO_DELTA_RAD=${DP3_MAXIMUM_INITIAL_ZERO_DELTA_RAD:-1.50}
DP3_ZERO_TOLERANCE_RAD=${DP3_ZERO_TOLERANCE_RAD:-0.08}
DP3_ZERO_STABLE_FRAMES=${DP3_ZERO_STABLE_FRAMES:-5}
DP3_ZERO_TIMEOUT_S=${DP3_ZERO_TIMEOUT_S:-25}
DP3_ZERO_MAX_ARM_STEP_RAD=${DP3_ZERO_MAX_ARM_STEP_RAD:-0.03}

# D435 yellow-cube phase detection learned from the accepted dataset images.
DP3_SELECTION_FRAMES=${DP3_SELECTION_FRAMES:-10}
DP3_START_CENTROID_FRAMES=${DP3_START_CENTROID_FRAMES:-5}
DP3_GOAL_CENTROID_FRAMES=${DP3_GOAL_CENTROID_FRAMES:-15}
DP3_MINIMUM_YELLOW_POINTS=${DP3_MINIMUM_YELLOW_POINTS:-8}
DP3_START_REGION_MARGIN_M=${DP3_START_REGION_MARGIN_M:-0.015}
DP3_MAXIMUM_GOAL_DISTANCE_M=${DP3_MAXIMUM_GOAL_DISTANCE_M:-0.050}
DP3_GOAL_MINIMUM_ELAPSED_S=${DP3_GOAL_MINIMUM_ELAPSED_S:-3.0}
DP3_GOAL_STABLE_FRAMES=${DP3_GOAL_STABLE_FRAMES:-8}
DP3_GOAL_OPEN_FRACTION=${DP3_GOAL_OPEN_FRACTION:-0.20}
# Every accepted demonstration kept the left gripper open for at least 38
# frames (2.53s at 15Hz). This blocks a premature first diffusion closure.
DP3_MINIMUM_GRIPPER_OPEN_S=${DP3_MINIMUM_GRIPPER_OPEN_S:-2.5}
DP3_RESTART_STABLE_FRAMES=${DP3_RESTART_STABLE_FRAMES:-15}
DP3_RESTART_COOLDOWN_S=${DP3_RESTART_COOLDOWN_S:-2.0}
DP3_RESTART_REPORT_S=${DP3_RESTART_REPORT_S:-5.0}
DP3_INFERENCE_SEED=${DP3_INFERENCE_SEED:-42}
# Preserve the last operator-tuned learned controller: one deterministic sample,
# the complete 15-action future suffix, and the exact final gain/step values.
DP3_INFERENCE_SAMPLES=${DP3_INFERENCE_SAMPLES:-1}
DP3_EXECUTE_FULL_PREDICTION_HORIZON=${DP3_EXECUTE_FULL_PREDICTION_HORIZON:-1}
DP3_ARM_ACTION_GAIN=${DP3_ARM_ACTION_GAIN:-0.87890625}
DP3_INITIAL_RAMP_S=${DP3_INITIAL_RAMP_S:-0.40}
DP3_INITIAL_ACTION_ALPHA=${DP3_INITIAL_ACTION_ALPHA:-0.90}
DP3_ACTION_ALPHA=${DP3_ACTION_ALPHA:-1.0}
DP3_INITIAL_MAX_ARM_STEP_RAD=${DP3_INITIAL_MAX_ARM_STEP_RAD:-0.029296875}
DP3_POLICY_MAX_ARM_STEP_RAD=${DP3_POLICY_MAX_ARM_STEP_RAD:-0.05859375}
DP3_MAXIMUM_TRACKING_ERROR_RAD=${DP3_MAXIMUM_TRACKING_ERROR_RAD:-0.90}
DP3_TRACKING_ERROR_FRAMES=${DP3_TRACKING_ERROR_FRAMES:-10}

# Reject the DM enable acknowledgement (0x0055 -> -12.4676 rad) and wait for
# actual post-enable gripper state before applying current-pose hold.
DP3_FEEDBACK_TIMEOUT_S=${DP3_FEEDBACK_TIMEOUT_S:-3.0}
DP3_FEEDBACK_MARGIN_RAD=${DP3_FEEDBACK_MARGIN_RAD:-0.20}
DP3_FEEDBACK_SETTLE_S=${DP3_FEEDBACK_SETTLE_S:-0.010}
