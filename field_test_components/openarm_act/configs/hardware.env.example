# Copy this file to /home/mh/openarm_act/hardware.env only after checking the
# current session's physical connections. The launch scripts never source this
# example automatically.

# Current bridge evidence maps the left arm to can1 and right arm to can0.
# Keep these explicit because PEAK adapter enumeration can swap after reconnect.
OPENARM_LEFT_CAN=can1
OPENARM_RIGHT_CAN=can0

# Fill with numeric serial numbers from the physical cameras.
CHEST_SERIAL=
WRIST_LEFT_SERIAL=

OPENARM_TELEMETRY_HOST=127.0.0.1
OPENARM_TELEMETRY_PORT=29502
OPENARM_TELEMETRY_HZ=100
OPENARM_TELEMETRY_STALE_TIMEOUT_S=0.1

LEROBOT_DATASET_REPO_ID=local/openarm_v1_bimanual_act
LEROBOT_TASK="Support the object with the right arm and pick and place it with the left arm"
