# Physical hardware bindings for the current OpenArm imitation-learning setup.
# The D435I identifies the user-described chest D435ICB camera.
OPENARM_LEFT_CAN=can1
OPENARM_RIGHT_CAN=can0

CHEST_SERIAL=261722072049
WRIST_LEFT_SERIAL=260322271498

OPENARM_TELEMETRY_HOST=127.0.0.1
OPENARM_TELEMETRY_PORT=29502
OPENARM_TELEMETRY_HZ=100
OPENARM_TELEMETRY_STALE_TIMEOUT_S=0.1

LEROBOT_DATASET_REPO_ID=local/openarm_cube_center_to_left
LEROBOT_TASK="Pick up the cube from the center of the table with the left gripper and place it 12 centimeters to the left."
